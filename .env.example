# Set true for the anonymous shared deployment. Public mode prepares a read-only headline result.
EVIDUE_PUBLIC_DEMO=false
# Optional: live contract-to-rule compilation.
GEMINI_API_KEY=
# Optional model override.
GEMINI_MODEL=gemini-2.5-flash-lite
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
# Set POSTHOG_HOST to the same HTTPS origin when analytics is enabled so the
# server can allow that exact connection origin in its Content Security Policy.
POSTHOG_HOST=
EVIDUE_BETA_FORM_URL=
