# Evidue local configuration
#
# Copy this file to .env:
#   cp .env.example .env
#
# Never commit real secrets.

# Required for protected /pilot access.
# Generate locally with:
#   openssl rand -hex 32
EVIDUE_PILOT_TOKEN=

# Optional multi-workspace configuration.
# Example structure only; do not place real tokens here.
# EVIDUE_WORKSPACE_TOKENS={"workspace-a":"","workspace-b":""}

# Local pilot database.
EVIDUE_PILOT_DB_PATH=data/evidue-pilot.db

# Required for live compilation of custom agreements.
# Leave empty for recorded/offline demo behavior where supported.
GEMINI_API_KEY=

# Optional Gemini model override.
GEMINI_MODEL=
